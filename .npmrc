# better-sqlite3 ships a precompiled binary for Linux/macOS/Windows and needs
# no build step. npm's registry metadata sometimes flags it as having an
# install script anyway (a known quirk unrelated to this project), which can
# trigger an unnecessary node-gyp compile attempt on some networks. Skipping
# lifecycle scripts avoids that path entirely; nothing in this project's
# dependency tree relies on a postinstall step to function.
ignore-scripts=true
